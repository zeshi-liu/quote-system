server {
 listen 80;
 server_name ${QUOTE_DOMAIN};
 return 301 https://$host$request_uri;
}
server {
 listen 443 ssl;
 server_name ${QUOTE_DOMAIN};
 ssl_certificate /certs/fullchain.pem;
 ssl_certificate_key /certs/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 client_max_body_size 29m;
 # Access logs are disabled to avoid credential-bearing download URLs.
 access_log off;
 error_log /var/log/nginx/error.log crit;
 root /usr/share/nginx/html;
 location /api/ {
   proxy_pass http://api:3000;
   proxy_set_header Host $host;
   proxy_set_header X-Forwarded-Host $host;
   proxy_set_header X-Forwarded-Proto https;
   proxy_set_header X-Forwarded-For $remote_addr;
   proxy_read_timeout 30s;
 }
 location /supplier/ { try_files $uri $uri/ /supplier/index.html; }
 location /mobile/ { return 404; } # Enable only after building with an approved H5 base path.
 location / { try_files $uri $uri/ /index.html; }
 location ~* \.(?:js|css|woff2?)$ { try_files $uri =404; }
}
