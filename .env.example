DATABASE_URL=postgresql://quote_user:replace_me@127.0.0.1:5432/quote_system
DB_POOL_MAX=5
API_HOST=127.0.0.1
API_PORT=3000
SUPPLIER_WEB_URL=http://127.0.0.1:5174
# 生产必须改为实际同源HTTPS入口；Cookie/CSRF不信任请求Host或任意Origin。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5176,http://localhost:5176
TRIAL_PASSWORD_LOGIN=false
# 注册小程序后仅在服务端配置真实凭证；禁止提交 .env。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 实际文件导出需要独立启动 pnpm dev:worker。开发 local 显式启用，生产仅 COS。
FILE_STORAGE_DRIVER=
FILE_STORAGE_LOCAL_DIR=.local/exports
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 仅供旧开发环境兜底。生产新报价使用 PC 管理端维护的启用默认模板；已冻结版本沿用原内容。
QUOTE_SELLER_NAME=
QUOTE_CONTACT=
QUOTE_NOTES=
# Linux 建议用合法授权的 Noto CJK；Mac fallback 仅用于本机开发，不随代码分发。
EXPORT_FONT_PATH=
EXPORT_FONT_FAMILY=

# 原单图片 OCR：未配置时明确提示不可用，可手工校对或导入表格，不伪造识别成功。
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

# 默认只生成站内待回款；微信须真实 AppID、可用模板、字段映射及有效订阅授权。
REMINDER_SEND_WECHAT=false
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_PAGE=pages/index/index
WECHAT_REMINDER_FIELDS=
WECHAT_MINIPROGRAM_STATE=formal

# 单机生产配置、迁移/初始化、加密异机备份与隔离恢复见 docs/deployment-runbook-v1.md。
# 不把迁移角色或备份凭据放进前端，也不使用本示例的 replace_me 上线。
